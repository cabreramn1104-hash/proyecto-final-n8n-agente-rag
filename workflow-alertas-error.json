      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $json.execution ?? {};\nreturn {\n  json: {\n    fecha: new Date().toISOString(),\n    workflow: $json.workflow?.name ?? '(desconocido)',\n    ejecucion_id: e.id ?? '',\n    url: e.url ?? '',\n    nodo: e.lastNodeExecuted ?? e.error?.node?.name ?? '',\n    modo: e.mode ?? '',\n    mensaje: String(e.error?.message ?? 'sin mensaje').slice(0, 500)\n  }\n};"
      },
